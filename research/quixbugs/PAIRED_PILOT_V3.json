    "candidate_hash_semantics": {
      "applied_patch_event": "sha256(canonical_json({\"patch\": diff})) where diff is the apply_patch action arguments.patch from the events log; used when the verifier never ran and a candidate was applied pre-validate (candidate_provenance = applied_patch_event)",
      "verifier_record": "sha256(canonical_json(PatchRecord.to_mapping())) where PatchRecord is the verifier apply-metadata record (attempted, success, no_op, changed_files, hunk_count, error); used when the verifier ran (candidate_provenance = verifier_record)"
    },
    "counter_semantics": {
      "case_duration": "wall_clock_duration_seconds <= total_case_timeout_seconds",
      "directive_feedback": "valid_directives <= logical_model_calls; malformed_directive_rejections <= max_malformed_directive_feedback_cycles; bounded_directive_feedback_events >= malformed_directive_rejections",
      "gate_counts": "derived from actual boolean gate decisions",
      "observations": "successful plus failed named observation counts; each requires a started session",
      "sessions_started": "actual start_pdb_session lifecycle events; never gate-list length",
      "transport": "provider_process_attempts <= logical_model_calls * max_transport_attempts_per_logical_call; retries <= logical_model_calls * max_transport_retries_per_logical_call and retries <= attempts"
    },
    "cross_case_capability_contract": {
      "authority_checks": "Only ValidatedAuthorityCheckBinding instances issued by validate_authority_checks are accepted; records must first pass validate_authority_check_record.",
