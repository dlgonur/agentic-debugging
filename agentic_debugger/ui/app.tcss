/* Agentic Debugging — one deliberate default theme (dark, developer-tool).

   Layout rule: the workspace is a compact vertical stack (header / tabbed
   panes / status bar) that stays navigable at 80x24 and uses the extra
   space at larger sizes.  No hard-coded pane widths; tabs collapse the
   domain panes instead of shrinking them to unreadable slivers.
 */

Screen {
    background: #0d1117;
    color: #c9d1d9;
}

/* -- history screen ----------------------------------------------------- */

#home-title {
    padding: 1 2 0 2;
    text-style: bold;
}

#home-empty {
    padding: 1 2;
    margin: 1 2;
    background: #161b22;
    border: round #2c3a47;
}

#history-table {
    margin: 0 1;
    height: 1fr;
}

#history-table > .datatable--header {
    background: #161b22;
    color: #8b949e;
    text-style: bold;
}

#history-table > .datatable--cursor {
    background: #1f6feb;
    color: #ffffff;
}

#home-hint {
    padding: 0 2 1 2;
    color: #8b949e;
}

/* -- new-session screen ------------------------------------------------- */

#start-scroll {
    align-horizontal: center;
    width: 1fr;
    height: 1fr;
    scrollbar-size: 1 1;
}

#start-card {
    width: 100%;
    max-width: 70;
    height: auto;
    padding: 1 2 0 2;
    margin: 0;
    background: #0d1117;
    border: none;
}

#start-title {
    padding: 0;
    color: #c9d1d9;
    height: auto;
}

.field-label {
    color: #8b949e;
    text-style: bold;
    height: 1;
    margin: 0;
}

#start-card RadioSet {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0;
    background: transparent;
    border: none;
}

#start-card RadioSet:focus {
    border: none;
    background: transparent;
}

#start-card RadioSet > RadioButton {
    width: 1fr;
    height: 1;
    padding: 0;
    margin: 0;
    background: transparent;
    border: none;
    color: #c9d1d9;
}

#start-card RadioSet > RadioButton > .toggle--button {
    color: #484f58;
    background: #21262d;
}

#start-card RadioSet > RadioButton.-on > .toggle--button {
    color: #58a6ff;
    background: #21262d;
}

#start-card RadioSet > RadioButton.-on > .toggle--label {
    color: #e6edf3;
    background: transparent;
    text-style: bold;
}

#start-card RadioSet:focus > RadioButton.-selected > .toggle--label {
    background: transparent;
    color: #ffffff;
}

#start-card RadioSet:blur > RadioButton.-selected > .toggle--label {
    background: transparent;
    color: #c9d1d9;
}

#start-card Select,
#start-card Input {
    width: 100%;
    height: 1;
    margin: 0 0 1 0;
    background: #161b22;
    border: none;
    padding: 0 1;
}

#start-card Select > SelectCurrent {
    border: none;
    background: #161b22;
    padding: 0 1;
    height: 1;
}

#start-card Select:focus > SelectCurrent,
#start-card Input:focus {
    border: none;
    background-tint: #21262d 10%;
}

#start-card Select > SelectOverlay {
    width: 100%;
    max-width: 100%;
    max-height: 8;
    padding: 0;
    border: tall #30363d;
    background: #161b22;
}

#start-card Select > SelectOverlay:focus {
    border: tall #30363d;
}

#start-card Select > SelectOverlay > .option-list--option {
    padding: 0 1;
}

#task-field {
    width: 100%;
    height: 2;
    background: #161b22;
    border: none;
    padding: 0 1;
    color: #c9d1d9;
}

#task-field:focus {
    background-tint: #21262d 10%;
    border: none;
}

#task-chooser-dialog {
    width: 60;
    max-width: 70;
    height: 18;
    max-height: 70%;
    background: #21262d;
    border: none;
    padding: 1 1;
}

#task-chooser-title {
    height: 1;
    color: #c9d1d9;
    text-style: bold;
    padding: 0;
    margin: 0 0 1 0;
}

#task-chooser-list {
    height: 1fr;
    background: #21262d;
    border: none;
    padding: 0;
    scrollbar-gutter: stable;
    scrollbar-size: 1 1;
    scrollbar-color: #30363d;
    scrollbar-background: #21262d;
    scrollbar-corner-color: #21262d;
}

#task-chooser-list > .option-list--option {
    padding: 0 1;
    color: #8b949e;
}

#task-chooser-list > .option-list--option-highlighted {
    background: #30363d;
    color: #ffffff;
    text-style: bold;
}

#task-chooser-list:focus > .option-list--option-highlighted {
    background: #30363d;
    color: #ffffff;
    text-style: bold;
}

#task-chooser-hint {
    height: 1;
    color: #8b949e;
    padding: 0;
    margin: 1 0 0 0;
}

TaskChooserScreen {
    align: center middle;
    background: #0d1117 70%;
}

#config-info {
    height: auto;
    color: #8b949e;
    margin: 0;
}

#profile-label,
#profile-select {
    margin-bottom: 0;
}

#profile-row {
    width: 100%;
    height: 1;
    margin: 0 0 1 0;
    display: none;
}

#profile-row Label {
    width: 15;
    height: 1;
    padding: 0 1 0 0;
    color: #8b949e;
}

#profile-row Select {
    width: 1fr;
    height: 1;
    margin-bottom: 0;
}

.start-actions {
    height: 1;
    margin: 1 0 0 0;
    align-horizontal: left;
}

.start-actions Button {
    height: 1;
    min-width: 16;
    padding: 0 2;
    margin: 0 1 0 0;
    border: none;
}

.start-actions #start-button {
    background: #1f6feb;
    color: #ffffff;
    border: none;
}

.start-actions #start-button:focus {
    background: #1f6feb;
    border: none;
    background-tint: #ffffff 12%;
}

.start-actions #history-button {
    background: #21262d;
    color: #c9d1d9;
    border: none;
}

.start-actions #history-button:focus {
    border: none;
    background: #30363d;
}

#start-error {
    height: auto;
    padding: 0;
    color: #f85149;
}

#start-hint {
    height: auto;
    padding: 0;
    color: #8b949e;
    display: none;
}

/* -- workspace ----------------------------------------------------------- */

#status-header {
    dock: top;
    padding: 0 2;
    background: #161b22;
    color: #c9d1d9;
    text-style: bold;
    height: auto;
}

#pane-tabs {
    margin: 0 1;
    height: 1fr;
}

#pane-tabs ContentTabs {
    background: #161b22;
}

#pane-tabs ContentTabs > Tab {
    color: #8b949e;
}

#pane-tabs ContentTabs > Tab.--active {
    color: #58a6ff;
    text-style: bold;
}

#pane-tabs ContentTabs > Tab:focus {
    color: #ffffff;
}

#pane-tabs ContentSwitcher {
    background: #0d1117;
    border: round #2c3a47;
    padding: 0 1;
}

SourcePanel, DebuggerPanel, PatchPanel, VerifierPanel, ActivityPanel, TimelinePanel {
    height: 1fr;
    background: #0d1117;
    color: #c9d1d9;
}

SourcePanel Static, DebuggerPanel Static, PatchPanel Static,
VerifierPanel Static, ActivityPanel Static, TimelinePanel Static {
    width: 1fr;
}

#replay-bar, #live-bar {
    dock: bottom;
    padding: 0 2;
    background: #161b22;
    color: #8b949e;
    height: auto;
}

/* -- jump-to-sequence modal ---------------------------------------------- */

#jump-dialog {
    padding: 1 2;
    margin: 2 4;
    background: #161b22;
    border: round #58a6ff;
    height: auto;
}

#jump-title {
    padding: 1 0 0 0;
    text-style: bold;
}

#jump-hint {
    padding: 0 0 1 0;
    color: #8b949e;
}

#jump-input {
    margin: 1 0;
}

/* -- help modal --------------------------------------------------------- */

#help-dialog {
    padding: 1 2;
    margin: 1 4;
    background: #161b22;
    border: round #58a6ff;
    height: auto;
    max-height: 90%;
}

#help-title {
    padding: 0 0 1 0;
    text-style: bold;
}

#help-content {
    padding: 0 0 1 0;
}

#help-hint {
    padding: 0 0 0 0;
    color: #8b949e;
}

/* -- shared focus language ------------------------------------------------ */

Button:focus {
    border: tall #30363d;
}

Button {
    margin: 1 2;
}
