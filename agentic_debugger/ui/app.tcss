/* Agentic Debugging — one deliberate default theme (dark, developer-tool).

   Layout rule: the workspace is a compact vertical stack (header / tabbed
   panes / status bar) that stays navigable at 80x24 and uses the extra
   space at larger sizes.  No hard-coded pane widths; tabs collapse the
   domain panes instead of shrinking them to unreadable slivers.
 */

Screen {
    background: #0d1117;
    color: #c9d1d9;
}

/* -- history screen ----------------------------------------------------- */

#home-title {
    padding: 1 2 0 2;
    text-style: bold;
}

#home-empty {
    padding: 1 2;
    margin: 1 2;
    background: #161b22;
    border: round #2c3a47;
}

#history-table {
    margin: 0 1;
    height: 1fr;
}

#history-table > .datatable--header {
    background: #161b22;
    color: #8b949e;
    text-style: bold;
}

#history-table > .datatable--cursor {
    background: #1f6feb;
    color: #ffffff;
}

#home-hint {
    padding: 0 2 1 2;
    color: #8b949e;
}

/* -- new-session screen ------------------------------------------------- */

#start-scroll {
    align-horizontal: center;
    width: 1fr;
    height: 1fr;
    scrollbar-size: 1 1;
}

#start-card {
    width: 100%;
    max-width: 72;
    height: auto;
    padding: 1 2;
    margin: 0;
    background: #111820;
    border: round #263747;
}

#start-title {
    padding: 0 0 1 0;
    color: #c9d1d9;
    height: auto;
}

.field-row {
    width: 100%;
    height: auto;
}

.field-section {
    width: 1fr;
    height: auto;
    margin: 0 1 0 0;
}

.section-heading {
    color: #79c0ff;
    text-style: bold;
    height: 1;
}

.field-label {
    color: #c9d1d9;
    height: 1;
}

#start-card Select,
#start-card Input {
    width: 100%;
    height: 3;
    margin: 0;
    background: #161f2a;
    border: round #344454;
}

#start-card Select > SelectCurrent {
    border: round #344454;
    background: #161f2a;
    padding: 0 1;
}

#start-card Select:focus > SelectCurrent,
#start-card Input:focus {
    border: round #6e9ccf;
    background-tint: #79c0ff 5%;
}

#start-card Select > SelectOverlay {
    width: 100%;
    max-width: 100%;
    max-height: 8;
    padding: 0;
    border: round #526d87;
    background: #182331;
}

#start-card Select > SelectOverlay:focus {
    border: round #6e9ccf;
}

#start-card Select > SelectOverlay > .option-list--option {
    padding: 0 1;
}

#config-info {
    height: auto;
    color: #8b949e;
}

#profile-label,
#profile-select {
    margin-bottom: 1;
}

#profile-row {
    width: 100%;
    height: 3;
    margin: 0 0 1 0;
}

#profile-row Label {
    width: 15;
    height: 3;
    padding: 1 1 0 0;
}

#profile-row Select {
    width: 1fr;
    height: 3;
    margin-bottom: 0;
}

.start-actions {
    height: 3;
    margin: 0 0 1 0;
    align-horizontal: left;
}

.start-actions Button {
    height: 3;
    min-width: 16;
    margin: 0 1 0 0;
}

#start-error {
    height: auto;
    padding: 0;
    color: #f85149;
}

#start-hint {
    height: auto;
    padding: 0;
    color: #8b949e;
}

/* -- workspace ----------------------------------------------------------- */

#status-header {
    dock: top;
    padding: 0 2;
    background: #161b22;
    color: #c9d1d9;
    text-style: bold;
    height: auto;
}

#pane-tabs {
    margin: 0 1;
    height: 1fr;
}

#pane-tabs ContentTabs {
    background: #161b22;
}

#pane-tabs ContentTabs > Tab {
    color: #8b949e;
}

#pane-tabs ContentTabs > Tab.--active {
    color: #58a6ff;
    text-style: bold;
}

#pane-tabs ContentTabs > Tab:focus {
    color: #ffffff;
}

#pane-tabs ContentSwitcher {
    background: #0d1117;
    border: round #2c3a47;
    padding: 0 1;
}

SourcePanel, DebuggerPanel, PatchPanel, VerifierPanel, ActivityPanel, TimelinePanel {
    height: 1fr;
    background: #0d1117;
    color: #c9d1d9;
}

SourcePanel Static, DebuggerPanel Static, PatchPanel Static,
VerifierPanel Static, ActivityPanel Static, TimelinePanel Static {
    width: 1fr;
}

#replay-bar, #live-bar {
    dock: bottom;
    padding: 0 2;
    background: #161b22;
    color: #8b949e;
    height: auto;
}

/* -- jump-to-sequence modal ---------------------------------------------- */

#jump-dialog {
    padding: 1 2;
    margin: 2 4;
    background: #161b22;
    border: round #58a6ff;
    height: auto;
}

#jump-title {
    padding: 1 0 0 0;
    text-style: bold;
}

#jump-hint {
    padding: 0 0 1 0;
    color: #8b949e;
}

#jump-input {
    margin: 1 0;
}

/* -- help modal --------------------------------------------------------- */

#help-dialog {
    padding: 1 2;
    margin: 1 4;
    background: #161b22;
    border: round #58a6ff;
    height: auto;
    max-height: 90%;
}

#help-title {
    padding: 0 0 1 0;
    text-style: bold;
}

#help-content {
    padding: 0 0 1 0;
}

#help-hint {
    padding: 0 0 0 0;
    color: #8b949e;
}

/* -- shared focus language ------------------------------------------------ */

Button:focus {
    border: round #6e9ccf;
}

Button {
    margin: 1 2;
}
