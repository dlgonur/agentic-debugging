/* Agentic Debugging — one deliberate default theme (dark, developer-tool).

   Layout rule: the workspace is a compact vertical stack (header / tabbed
   panes / status bar) that stays navigable at 80x24 and uses the extra
   space at larger sizes.  No hard-coded pane widths; tabs collapse the
   domain panes instead of shrinking them to unreadable slivers.
 */

Screen {
    background: #0d1117;
    color: #c9d1d9;
}

/* -- history screen ----------------------------------------------------- */

#home-title {
    padding: 1 2 0 2;
    text-style: bold;
}

#home-empty {
    padding: 1 2;
    margin: 1 2;
    background: #161b22;
    border: round #2c3a47;
}

#history-table {
    margin: 0 1;
    height: 1fr;
}

#history-table > .datatable--header {
    background: #161b22;
    color: #8b949e;
    text-style: bold;
}

#history-table > .datatable--cursor {
    background: #1f6feb;
    color: #ffffff;
}

#home-hint {
    padding: 0 2 1 2;
    color: #8b949e;
}

/* -- new-session workspace --------------------------------------------- */

#start-workspace {
    height: 1fr;
    width: 1fr;
}

#start-main {
    width: 1fr;
    height: 1fr;
}

#start-config {
    width: 1fr;
    height: 1fr;
    padding: 1 2 0 2;
    scrollbar-size: 1 1;
}

#start-title {
    height: 3;
    padding: 0;
    color: #c9d1d9;
}

SessionSettingRow,
TimeLimitRow {
    width: 1fr;
    height: 1;
    padding: 0;
    margin: 0;
    color: #c9d1d9;
}

SessionSettingRow:focus,
TimeLimitRow:focus {
    background: #161b22;
    color: #ffffff;
}

#model-row {
    display: none;
}

#time-limit-display {
    width: 1fr;
    height: 1;
}

#time-limit-input {
    width: 18;
    height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    background: #161b22;
    color: #ffffff;
}

#start-status,
#start-trust {
    width: 1fr;
    height: auto;
    padding: 0;
    margin: 1 0 0 2;
    color: #8b949e;
}

#start-footer {
    width: 1fr;
    height: 1;
    padding: 0 2;
    color: #8b949e;
    background: #161b22;
}

#start-context {
    width: 34;
    height: 1fr;
    padding: 1 2;
    background: #111820;
    scrollbar-size: 1 1;
}

#context-title {
    height: 1;
    color: #8b949e;
    text-style: bold;
}

#context-summary {
    height: auto;
    padding: 1 0 0 0;
    color: #c9d1d9;
}

#choice-picker-dialog {
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: #161b22;
}

#choice-picker-title {
    height: 1;
    padding: 0;
    margin: 0 0 1 0;
    color: #c9d1d9;
    text-style: bold;
}

#choice-picker-list {
    width: 1fr;
    height: auto;
    max-height: 16;
    padding: 0;
    background: #161b22;
    border: none;
    scrollbar-size: 1 1;
    scrollbar-color: #30363d;
    scrollbar-background: #161b22;
}

#choice-picker-list > .option-list--option {
    padding: 0 1;
    color: #8b949e;
}

#choice-picker-list > .option-list--option-highlighted,
#choice-picker-list:focus > .option-list--option-highlighted {
    background: #3b4652;
    color: #ffffff;
    text-style: bold;
}

#choice-picker-empty {
    height: 1;
    padding: 0 1;
    color: #f2cc60;
}

#choice-picker-hint {
    height: 2;
    padding: 1 0 0 0;
    color: #8b949e;
}

ChoicePickerScreen {
    align: center middle;
    background: #0d1117 90%;
}

/* -- workspace ----------------------------------------------------------- */

#status-header {
    dock: top;
    padding: 0 2;
    background: #161b22;
    color: #c9d1d9;
    text-style: bold;
    height: auto;
}

#pane-tabs {
    margin: 0 1;
    height: 1fr;
}

#pane-tabs ContentTabs {
    background: #161b22;
}

#pane-tabs ContentTabs > Tab {
    color: #8b949e;
}

#pane-tabs ContentTabs > Tab.--active {
    color: #58a6ff;
    text-style: bold;
}

#pane-tabs ContentTabs > Tab:focus {
    color: #ffffff;
}

#pane-tabs ContentSwitcher {
    background: #0d1117;
    border: round #2c3a47;
    padding: 0 1;
}

SourcePanel, DebuggerPanel, PatchPanel, VerifierPanel, ActivityPanel, TimelinePanel {
    height: 1fr;
    background: #0d1117;
    color: #c9d1d9;
}

SourcePanel Static, DebuggerPanel Static, PatchPanel Static,
VerifierPanel Static, ActivityPanel Static, TimelinePanel Static {
    width: 1fr;
}

#replay-bar, #live-bar {
    dock: bottom;
    padding: 0 2;
    background: #161b22;
    color: #8b949e;
    height: auto;
}

/* -- jump-to-sequence modal ---------------------------------------------- */

#jump-dialog {
    padding: 1 2;
    margin: 2 4;
    background: #161b22;
    border: round #58a6ff;
    height: auto;
}

#jump-title {
    padding: 1 0 0 0;
    text-style: bold;
}

#jump-hint {
    padding: 0 0 1 0;
    color: #8b949e;
}

#jump-input {
    margin: 1 0;
}

/* -- help modal --------------------------------------------------------- */

#help-dialog {
    padding: 1 2;
    margin: 1 4;
    background: #161b22;
    border: round #58a6ff;
    height: auto;
    max-height: 90%;
}

#help-title {
    padding: 0 0 1 0;
    text-style: bold;
}

#help-content {
    padding: 0 0 1 0;
}

#help-hint {
    padding: 0 0 0 0;
    color: #8b949e;
}

/* -- shared focus language ------------------------------------------------ */

Button:focus {
    border: tall #30363d;
}

Button {
    margin: 1 2;
}
