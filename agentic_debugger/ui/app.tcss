/* Agentic Debugger — forensic instrument console.

   Cyan is live signal and interaction. Amber belongs to evidence and
   verifier authority. Layered blue-black surfaces provide depth without
   glow or decorative chrome. The compact stack remains navigable at 80x24;
   wider terminals earn context rather than stretched line length.
 */

Screen {
    background: $background;
    color: $foreground;
    scrollbar-color: $line-strong;
    scrollbar-background: $surface;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $primary;
}

/* -- home / welcome screen -------------------------------------------- */

HomeScreen {
    align: center middle;
    background: $background;
}

#home-screen-wrap {
    width: 100%;
    height: 100%;
    align: center middle;
}

#home-container {
    width: 92;
    height: auto;
    align-horizontal: center;
}

#home-hero-panel {
    width: 100%;
    height: auto;
    align-horizontal: center;
    margin: 0 0 1 0;
}

#home-brand-banner {
    width: 100%;
    height: auto;
    content-align: center middle;
    text-wrap: nowrap;
    margin: 0 0 1 0;
}

#home-brand-tagline {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-wrap: nowrap;
    margin: 0;
}

#home-brand-telemetry {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-wrap: nowrap;
    margin: 0;
}

#home-actions-panel {
    width: 100%;
    height: auto;
    border: round $line;
    background: $surface;
    padding: 1 2;
    margin: 0 0 1 0;
}

HomeActionRow {
    width: 100%;
    height: 1;
    margin: 0 0 1 0;
    padding: 0;
}

HomeActionRow:last-of-type {
    margin: 0;
}

HomeActionRow:focus {
    background: $selection;
}

#action-help {
    margin: 0;
}

#home-recent-panel {
    width: 100%;
    height: auto;
    content-align: center middle;
    margin: 0;
}

#home-recent-status {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-wrap: nowrap;
}

#home-footer-bar {
    dock: bottom;
    width: 100%;
    height: 1;
    padding: 0 2;
    background: $surface;
    color: $text-faint;
}

/* -- history archive screen ------------------------------------------- */

#history-header {
    width: 1fr;
    height: auto;
    padding: 1 3 1 3;
    background: $background;
}

#history-title {
    height: 4;
    padding: 0;
    text-style: bold;
}

#history-summary {
    width: 1fr;
    height: 1;
    color: $text-faint;
}

#history-actions {
    width: 1fr;
    height: 1;
    margin: 1 0 0 0;
    align: left middle;
}

#history-empty {
    width: 1fr;
    height: 1fr;
    padding: 2 4;
    margin: 0 3 1 3;
    background: $surface;
    border: round $line;
    content-align: center middle;
}

#history-table {
    margin: 0 2;
    height: 1fr;
    border: round $line;
}

#history-table > .datatable--header {
    background: $surface;
    color: $foreground-muted;
    text-style: bold;
}

#history-table > .datatable--cursor {
    background: $primary;
    color: $background;
    text-style: bold;
}

#history-footer, #home-hint {
    dock: bottom;
    width: 1fr;
    height: 1;
    padding: 0 3;
    color: $text-faint;
    background: $surface;
}

/* -- new-session workspace --------------------------------------------- */

#start-workspace {
    height: 1fr;
    width: 1fr;
    background: $background;
}

#start-main {
    width: 1fr;
    height: 1fr;
}

#start-config {
    width: 1fr;
    height: 1fr;
    padding: 1 3 0 3;
    scrollbar-size: 1 1;
}

#start-hero {
    height: auto;
    min-height: 4;
    padding: 0 0 0 0;
    margin: 0 0 1 0;
    color: $foreground;
}

#start-title {
    height: 4;
    padding: 0;
    color: $foreground;
}

#start-section-label {
    width: 1fr;
    height: 1;
    margin: 1 0 0 0;
    color: $foreground-muted;
    text-style: bold;
}

#start-session-button {
    width: auto;
    min-width: 22;
    height: 1;
    padding: 0 2;
    margin: 0;
    background: $primary;
    color: $background;
    border: none;
    text-style: bold;
}

#start-session-button:hover,
#start-session-button:focus {
    background: $primary;
    color: $background;
    text-style: bold underline;
}

#start-session-button:disabled {
    background: $panel;
    color: $foreground-muted;
    text-style: none;
}

#start-method {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    padding: 1 2;
    background: $surface;
    border: round $line;
    color: $foreground;
}

SessionSettingRow {
    width: 1fr;
    height: 1;
    padding: 0;
    margin: 0;
    color: $foreground;
}

SessionSettingRow:focus {
    background: $selection;
    color: $foreground;
    text-style: bold;
}

#start-status {
    width: 1fr;
    height: auto;
    padding: 0;
    margin: 1 0 0 0;
    color: $foreground-muted;
}

#start-notes {
    width: 1fr;
    height: auto;
    padding: 0;
    margin: 0;
    color: $text-faint;
}

#start-footer {
    width: 1fr;
    height: 1;
    padding: 0 2;
    color: $text-faint;
    background: $surface;
}

#start-context {
    width: 36;
    height: 1fr;
    padding: 1 2;
    background: $surface;
    scrollbar-size: 1 1;
}

#context-title {
    height: 1;
    color: $primary;
    text-style: bold;
}

#context-summary {
    height: auto;
    padding: 1 0 0 0;
    color: $foreground;
}

#choice-picker-dialog {
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $surface;
    border: round $line;
}

#choice-picker-title {
    height: 1;
    padding: 0;
    margin: 0 0 1 0;
    color: $primary;
    text-style: bold;
}

#choice-picker-subtitle {
    height: auto;
    padding: 0;
    margin: 0 0 1 0;
    color: $foreground-muted;
}

#choice-picker-list {
    width: 1fr;
    height: auto;
    max-height: 16;
    padding: 0;
    background: $surface;
    border: none;
    scrollbar-size: 1 1;
    scrollbar-color: $line-strong;
    scrollbar-background: $surface;
}

#choice-picker-list > .option-list--option {
    padding: 0 1;
    color: $foreground;
}

#choice-picker-list > .option-list--option-highlighted,
#choice-picker-list:focus > .option-list--option-highlighted {
    background: $selection;
    color: $foreground;
}

#choice-picker-empty {
    height: 1;
    padding: 0 1;
    color: $warning;
}

#choice-picker-hint {
    height: 2;
    padding: 1 0 0 0;
    color: $foreground-muted;
}

#time-limit-dialog {
    width: 36;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $line;
}

#time-limit-title {
    height: 1;
    margin: 0 0 1 0;
    color: $primary;
    text-style: bold;
}

#time-limit-label {
    height: 1;
    color: $foreground-muted;
}

#time-limit-editor {
    width: 18;
    height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    border: none;
    background: $background;
    color: $foreground;
}

#time-limit-help,
#time-limit-hint {
    height: 1;
    color: $foreground-muted;
}

#time-limit-error {
    height: auto;
    color: $error;
}

TimeLimitEditorScreen {
    align: center middle;
    background: $background 90%;
}

ChoicePickerScreen {
    align: center middle;
    background: $background 90%;
}

BugDescriptionEditorScreen {
    align: center middle;
    background: $background 90%;
}

#bug-editor-dialog {
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    background: $surface;
    border: round $line;
}

#bug-editor-title {
    height: 1;
    margin: 0 0 1 0;
    color: $primary;
    text-style: bold;
}

#bug-editor {
    width: 1fr;
    height: 10;
    min-height: 8;
    max-height: 14;
    background: $background;
    color: $foreground;
    border: round $line;
    padding: 0 1;
}

#bug-editor:focus {
    border: round $focus-ring;
}

#bug-editor-actions {
    width: 1fr;
    height: auto;
    align: center middle;
    margin: 1 0 0 0;
}

#bug-save-button {
    width: auto;
    min-width: 12;
    height: 1;
    padding: 0 2;
    background: $primary;
    color: $background;
    border: none;
    text-style: bold;
}

#bug-save-button:hover {
    background: $primary;
    color: $background;
    text-style: bold underline;
}

#bug-save-button:focus {
    background: $primary;
    color: $background;
    border: none;
    text-style: bold underline;
}

#bug-editor-hint {
    height: 1;
    margin: 1 0 0 0;
    color: $foreground-muted;
}

#bug-editor-error {
    height: auto;
    color: $error;
}

SingleLineFieldEditorScreen {
    align: center middle;
    background: $background 90%;
}

#single-line-dialog {
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    background: $surface;
    border: round $line;
}

#single-line-title {
    height: 1;
    margin: 0 0 1 0;
    color: $primary;
    text-style: bold;
}

#single-line-editor {
    width: 1fr;
    height: 1;
    min-height: 1;
    background: $background;
    color: $foreground;
    border: round $line;
    padding: 0 1;
}

#single-line-editor:focus {
    border: round $focus-ring;
}

#single-line-actions {
    width: 1fr;
    height: auto;
    align: right middle;
    margin: 1 0 0 0;
}

#single-line-save-button {
    width: auto;
    min-width: 12;
    height: 1;
    padding: 0 2;
    background: $primary;
    color: $background;
    border: none;
    text-style: bold;
}

#single-line-save-button:hover {
    background: $primary;
    color: $background;
    text-style: bold underline;
}

#single-line-save-button:focus {
    background: $primary;
    color: $background;
    border: none;
    text-style: bold underline;
}

#single-line-hint {
    height: 1;
    margin: 1 0 0 0;
    color: $foreground-muted;
}

#single-line-error {
    height: auto;
    color: $error;
}

/* Legacy alias also centered (the tiny upper-left implementation is removed) */
_SingleLineEditorScreen {
    align: center middle;
    background: $background 90%;
}

/* -- workspace ----------------------------------------------------------- */

#workspace-body {
    width: 1fr;
    height: 1fr;
}

#workspace-main {
    width: 1fr;
    height: 1fr;
}

#live-run-context {
    display: none;
    width: 46;
    height: 1fr;
    padding: 1 2;
    background: $panel;
    color: $foreground;
    scrollbar-size: 1 1;
}

#status-header {
    dock: top;
    padding: 0 2;
    background: $surface;
    color: $foreground;
    text-style: bold;
    height: auto;
}

#pane-tabs {
    margin: 0 1;
    height: 1fr;
}

#pane-tabs ContentTabs {
    background: $surface;
}

#pane-tabs ContentTabs > Tab {
    color: $foreground-muted;
}

#pane-tabs ContentTabs > Tab.--active {
    color: $focus-ring;
    text-style: bold;
}

#pane-tabs ContentTabs > Tab:focus {
    color: $foreground;
}

#pane-tabs ContentSwitcher {
    background: $background;
    border: round $line;
    padding: 0 1;
}

EvidenceReviewPanel, SourcePanel, DebuggerPanel, PatchPanel, VerifierPanel, ActivityPanel, TimelinePanel {
    height: 1fr;
    background: $background;
    color: $foreground;
}

WorkstreamPanel {
    height: auto;
    padding: 0 1;
    background: $background;
    color: $foreground;
    scrollbar-size: 1 1;
}

WorkstreamPanel Static {
    width: 1fr;
}

EvidenceReviewPanel Static, SourcePanel Static, DebuggerPanel Static, PatchPanel Static,
VerifierPanel Static, ActivityPanel Static, TimelinePanel Static {
    width: 1fr;
}

#replay-bar, #live-bar {
    dock: bottom;
    padding: 0 2;
    background: $surface;
    color: $foreground-muted;
    height: auto;
}

/* -- jump-to-sequence modal ---------------------------------------------- */

#jump-dialog {
    padding: 1 2;
    margin: 2 4;
    background: $surface;
    border: round $focus-ring;
    height: auto;
}

#jump-title {
    padding: 1 0 0 0;
    text-style: bold;
}

#jump-hint {
    padding: 0 0 1 0;
    color: $foreground-muted;
}

#jump-input {
    margin: 1 0;
}

/* -- help modal --------------------------------------------------------- */

#help-dialog {
    padding: 1 2;
    margin: 1 4;
    background: $surface;
    border: round $focus-ring;
    height: auto;
    max-height: 90%;
}

#effort-dialog {
    padding: 1 2;
    margin: 1 4;
    background: $surface;
    border: round $evidence;
    height: auto;
    max-height: 90%;
}

#effort-body {
    padding: 0 0 1 0;
}

#help-title {
    padding: 0 0 1 0;
    text-style: bold;
}

#help-content {
    padding: 0 0 1 0;
}

#help-hint {
    padding: 0 0 0 0;
    color: $foreground-muted;
}

/* -- activity / timeline copy bar ---------------------------------------- */

#activity-container, #timeline-container {
    height: 1fr;
    width: 1fr;
}

#activity-copy-bar, #timeline-copy-bar {
    height: 1;
    width: 1fr;
    align: right middle;
    padding: 0 1;
    background: $background;
}

.copy-button {
    width: auto;
    min-width: 10;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $foreground-muted;
    border: none;
    text-style: none;
}

.copy-button:hover {
    background: $line-strong;
    color: $foreground;
}

.copy-button:focus {
    background: $panel;
    color: $foreground-muted;
    border: none;
}

/* -- shared focus language ------------------------------------------------ */

Button:focus {
    border: tall $line-strong;
}

Button {
    margin: 1 2;
}

.primary-action,
.secondary-action {
    width: auto;
    min-width: 22;
    height: 1;
    padding: 0 2;
    margin: 0 1 0 0;
    border: none;
    text-style: bold;
}

.primary-action {
    background: $primary;
    color: $background;
}

.primary-action:hover,
.primary-action:focus {
    background: $primary;
    color: $background;
    border: none;
    text-style: bold underline;
}

.secondary-action {
    background: $surface-raised;
    color: $foreground;
}

.secondary-action:hover,
.secondary-action:focus {
    background: $primary;
    color: $background;
    border: none;
}

.primary-action:disabled,
.secondary-action:disabled {
    background: $panel;
    color: $text-faint;
    text-style: none;
}

.copy-button {
    margin: 0;
}

#start-actions {
    width: 1fr;
    height: auto;
    align: left middle;
    margin: 1 0 0 0;
}
